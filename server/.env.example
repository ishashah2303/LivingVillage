# Copy to server/.env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace (Console > Settings > Workspaces, ID starts with wrkspc_)
# ANTHROPIC_WORKSPACE_ID=
# LV_PLANNER=llm            # or "rules" to skip Claude
# LV_MODEL=claude-opus-5-5
# LV_EFFORT=low
# LV_ALLOWED_ORIGINS=https://harjeet-chahal.github.io   # extra browser origins (scheme + host, no path)
# LV_LLM_PER_CLIENT=20      # Claude plans per client per hour; over it the rules answer
# LV_LLM_PER_HOUR=120       # Claude plans per hour for the whole service
